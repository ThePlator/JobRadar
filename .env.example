# Secrets only. Copy to .env and fill in; .env is git-ignored.

# Telegram user client — https://my.telegram.org → API development tools
TG_API_ID=123456
TG_API_HASH=xxxxxxxx

# Email — sends alerts/digests and reads jobs you forward to the JobRadar folder.
# Use an app password, not your account password (Gmail: https://myaccount.google.com/apppasswords)
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=
# Where alerts and digests go (defaults to EMAIL_ADDRESS)
NOTIFY_TO=

# Notion internal integration, shared with your duplicated JobRadar database
# (leave these out with notion.enabled: false in config.yaml: the dashboard is enough)
NOTION_TOKEN=ntn_xxx
# 32-character id from the database URL (before ?v=); JobRadar finds its data source itself
NOTION_DATABASE_ID=xxxxxxxx
# Only if the database has more than one data source:
# NOTION_DATA_SOURCE_ID=

# SaaS only (branch saas/main): Postgres instead of data/jobradar.db. A hosted one (Neon:
# Connect > connection string) or the local one from docker-compose.yml. Keep it secret.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SaaS only, signing in (docs/COMMANDS.md, "Signing in"). Kept here rather than in config.yaml,
# so config.yaml works unchanged on main. AUTH_ENABLED=true: every dashboard page needs signing in.
# AUTH_ENABLED=false
# AUTH_WAYS=google,email,phone          # the sign-in buttons; each must be on in Firebase too
# AUTH_SESSION_DAYS=14                  # how long you stay signed in on a device (at most 14)
# From Firebase: Project settings > Your apps > Web app. The sign-in page shows them; not secret.
# FIREBASE_API_KEY=AIza...
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project
# The service account key file (Project settings > Service accounts > Generate new private key;
# keep it in config/, never commit it), and the email that gets the admin role when it signs in.
# FIREBASE_CREDENTIALS=config/firebase-admin.json
# JOBRADAR_ADMIN_EMAIL=you@example.com

# LLM — set the key for the provider named in config.yaml
GEMINI_API_KEY=
GROQ_API_KEY=

# Google Drive folder for resumes (required for the Notion Resume link)
GDRIVE_FOLDER_ID=
